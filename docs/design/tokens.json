{
  "$description": "Relay design tokens, v0.1. Colors are sRGB hex; sizes are CSS px (pt on iOS).",
  "color": {
    "light": {
      "ground": "#F6F6FA",
      "surface": "#FFFFFF",
      "ink": "#15161F",
      "ink2": "#55586D",
      "line": "#E4E5EE",
      "accent": "#6D4AFF",
      "accentInk": "#4326D6",
      "accentTint": "#EDE8FF",
      "onAccent": "#FFFFFF"
    },
    "dark": {
      "ground": "#0E0F15",
      "surface": "#181A23",
      "ink": "#F3F3F8",
      "ink2": "#A3A6BB",
      "line": "#2A2D3A",
      "accent": "#8C73FF",
      "accentInk": "#B3A3FF",
      "accentTint": "#231C47",
      "onAccent": "#0E0F15"
    },
    "zone": {
      "z1": { "name": "Recovery", "fill": "#4C9BFF", "on": "#0B1F3A" },
      "z2": { "name": "Endurance", "fill": "#2EC4B6", "on": "#06302C" },
      "z3": { "name": "Tempo", "fill": "#5BD16E", "on": "#0D3315" },
      "z4": { "name": "Threshold", "fill": "#FFC845", "on": "#3D2A00" },
      "z5": { "name": "VO2 max", "fill": "#FF9248", "on": "#3D1A00" },
      "z6": { "name": "Anaerobic", "fill": "#FF5C6B", "on": "#3D0710" },
      "z7": { "name": "Neuromuscular", "fill": "#D65CFF", "on": "#330A40" }
    },
    "status": {
      "healthy": { "zone": "z3", "light": { "bg": "#E3F7E7", "ink": "#17642A", "dot": "#2FA548" }, "dark": { "bg": "#12301A", "ink": "#8FE3A0", "dot": "#5BD16E" } },
      "needsSignIn": { "zone": "z4", "light": { "bg": "#FFF4D6", "ink": "#7A5200", "dot": "#E0A100" }, "dark": { "bg": "#3A2E0A", "ink": "#FFD872", "dot": "#FFC845" } },
      "failed": { "zone": "z6", "light": { "bg": "#FFE9EB", "ink": "#B4142A", "dot": "#E5384C" }, "dark": { "bg": "#3A1218", "ink": "#FF9AA5", "dot": "#FF5C6B" } }
    },
    "pacer": {
      "body": "#E9E3FF",
      "limb": "#D9D0FF",
      "headband": "#FF7A59",
      "cheek": "#FFB3C1",
      "sneaker": "#FFFFFF",
      "sneakerLine": "#BFC2D4",
      "nose": "#FF8FA3",
      "face": "#15161F"
    }
  },
  "font": {
    "sans": "'Plus Jakarta Sans', system-ui, -apple-system, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace"
  },
  "type": {
    "display": { "size": 40, "weight": 800, "lineHeight": 1.1, "tracking": "-0.03em" },
    "title": { "size": 24, "weight": 700, "lineHeight": 1.25 },
    "body": { "size": 17, "weight": 500, "lineHeight": 1.5 },
    "small": { "size": 14, "weight": 500, "lineHeight": 1.5 },
    "label": { "size": 13, "weight": 700, "tracking": "0.08em", "transform": "uppercase" },
    "mono": { "size": 15, "weight": 500, "lineHeight": 1.55 }
  },
  "space": [4, 8, 12, 16, 24, 32, 48],
  "radius": { "input": 10, "tile": 14, "card": 20, "pill": 999 },
  "touch": { "min": 44, "primaryButton": 52 }
}
